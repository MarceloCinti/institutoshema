# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pagopar (https://www.pagopar.com > Integrar con mi sitio) ---
# Si se dejan vacías, sólo se ofrece pago por transferencia bancaria.
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=

# --- Datos para transferencia bancaria (se muestran al alumno) ---
NEXT_PUBLIC_BANK_INFO="Banco: ____ | Cuenta Cte. N° ____ | Titular: Congregación Shema Israel | RUC: ____ | Alias: ____"
NEXT_PUBLIC_WHATSAPP=595981000000
